<?xml version="1.0" encoding="utf-8"?>
<full-backup-content>
    <!-- Keep preferences and metadata eligible for Android Auto Backup.
         Offline audio is intentionally NOT backed up (manual Spotui JSON saves metadata only).
         Private audio survives app updates but disappears when the app is uninstalled. -->
    <exclude domain="file" path="downloads/" />
        <exclude domain="sharedpref" path="google_device_sync_config.xml" />
        <exclude domain="sharedpref" path="google_sync_categories.xml" />
        <exclude domain="file" path="google_text_sync/" />
</full-backup-content>
